# Konfiguracja serwera dokumentacji DTR.
# Skopiuj ten plik jako ustawienia.toml i wpisz swoje wartosci.
# Serwer przeładowuje konfigurację na gorąco, ale zmiana portu wymaga restartu.

# Port startowy. Jesli zajęty, serwer próbuje port+1 (maksymalnie 5 prób).
port = 8080

# Nazwa serwisu w górnym menu oraz treść stopki.
site_name = "DTR Żarna"
footer = "Juchniewicz Kamil"
admin_email = "k.juchniewicz@zarna.pl"

# Logowanie domenowe przez LDAP / Active Directory.
# Zalogować może się każdy użytkownik domeny (login + hasło jak do komputera).
# Upewnij się, że kontroler akceptuje simple bind na wybranym porcie.
ldap_url  = "ldap://CONTROLLER_IP"
domain    = "example.com"        # próba: user@example.com
domain_nt = "EXAMPLE"            # fallback: EXAMPLE\user

# [users] – lista loginów domenowych, które mogą zaznaczać/odznaczać
# checkboxy w start.md ze strony głównej. Pozostali użytkownicy widzą
# checkboxy jako nieaktywne (tylko odczyt).
# Format: login = true
[users]
# kowalski = true
# nowak    = true
